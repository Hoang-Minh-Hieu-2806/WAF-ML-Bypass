# =============================================================================
# T03 — ML-based WAF & Evasion Techniques
# Copy: cp .env.example .env  rồi đổi DB_PASS thành giá trị riêng.
# Không commit file .env (đã bị .gitignore chặn).
# =============================================================================

# --- Database (service db, mysql:8.4 LTS, chỉ nội bộ webnet) ---
DB_PASS=changeme_strong_pass
MYSQL_DATABASE=waf_lab

# Web App kết nối qua service name `db`, KHÔNG dùng localhost.
DATABASE_URL=mysql://root:${DB_PASS}@db:3306/waf_lab

# --- Ports trên host (lab local) ---
WEBAPP_PORT=8080
WAF_CRS_PORT=8081
WAF_ML_PORT=8082

# --- WAF-CRS (Huy sở hữu rule, Hiếu sở hữu deployment) ---
# DetectionOnly ở Phase 1 để smoke-test benign qua được 200.
# Tuần 03-04 Huy chuyển sang On (blocking) + audit log.
PARANOIA=1
MODSEC_RULE_ENGINE=DetectionOnly
BACKEND=http://web-app:5000

# --- ML-WAF (Hoàng ML sở hữu model, Hiếu sở hữu deployment) ---
MODEL_VERSION=stub-0.1
