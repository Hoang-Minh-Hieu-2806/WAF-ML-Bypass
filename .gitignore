# =============================================================================
# T03 — ML-based WAF & Evasion Techniques
# Shared .gitignore (5-person team, ~3-month security research project)
#
# TRACK    : source code, configuration, documentation, experiment
#            definitions, bypass test cases, reproducibility artifacts.
# IGNORE   : generated output, caches, large datasets, model binaries,
#            logs, local state, secrets.
# ALWAYS   : every .gitkeep placeholder stays tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# OS / IDE
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.spyproject/
.ropeproject/

# -----------------------------------------------------------------------------
# Environment / Secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
local_settings.py

credentials/
secrets/
.streamlit/secrets.toml

# Private keys / certificates containing private material
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa*
id_ed25519*

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
# Byte-compiled / caches
__pycache__/
*.py[codz]
*$py.class
*.so
.pytest_cache/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# Virtual environments
.Python
.venv
venv/
ENV/
env/
env.bak/
venv.bak/

# Packaging / build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Test / coverage output
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
nosetests.xml
*.cover
cover/

# Notebooks / REPL
.ipynb_checkpoints
profile_default/
ipython_config.py

# Tooling caches & local tool state
.abstra/
tempCodeRunnerFile.py
.pdm-python
.pdm-build/
.pixi
__pypackages__/
cython_debug/
.pypirc
marimo/_static/
marimo/_lsp/
__marimo__/

# Frameworks / docs builds (template rules kept)
instance/
.webassets-cache
.scrapy
db.sqlite3
db.sqlite3-journal
docs/_build/
/site
*.mo
*.pot
*.sage.py

# -----------------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log/

# -----------------------------------------------------------------------------
# ML artifacts (trained models & checkpoints)
# -----------------------------------------------------------------------------
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.keras
*.safetensors
*.ckpt
*.pb
*.tflite
*.mlmodel

checkpoints/
runs/
mlruns/
wandb/
lightning_logs/

# -----------------------------------------------------------------------------
# Dataset
# -----------------------------------------------------------------------------
# dataset/bypass/** (bypass test cases) stays tracked.

# Large / generated data in raw and processed (placeholders stay tracked)
dataset/raw/*
!dataset/raw/.gitkeep
dataset/processed/*
!dataset/processed/.gitkeep

# Large array / columnar data anywhere in the repo
*.npy
*.npz
*.parquet
*.feather
*.arrow

# -----------------------------------------------------------------------------
# Experiments
# -----------------------------------------------------------------------------
# Experiment definitions, scripts and configs stay tracked.
# Only generated outputs / caches are ignored.
experiments/**/output/
experiments/**/outputs/
experiments/**/cache/
experiments/**/tmp/

# -----------------------------------------------------------------------------
# Logs (placeholders stay tracked)
# *.log blocks stray generated logs anywhere in the repo; sample logs kept
# as documentation examples under docs/ remain trackable.
# -----------------------------------------------------------------------------
*.log
!docs/**/*.log
logs/**
!logs/**/
!logs/**/.gitkeep

# -----------------------------------------------------------------------------
# Results — generated tables / graphs / raw output
# (placeholders stay tracked)
# -----------------------------------------------------------------------------
results/**
!results/**/
!results/**/.gitkeep

# -----------------------------------------------------------------------------
# Docker — local runtime only (Dockerfiles & compose configs stay tracked)
# -----------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml
docker/**/volumes/
docker/**/data/

# -----------------------------------------------------------------------------
# Databases — local instance files
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.mdb
pgdata/
mysql-data/
mariadb-data/

# -----------------------------------------------------------------------------
# Security testing artifacts (tool temporary output)
# -----------------------------------------------------------------------------
sqlmap-output/
sqlmap-report/
nmap-output/
scan-output/
.wafw00f/
*.pcap
*.pcapng

# -----------------------------------------------------------------------------
# Caches / local services / temporary files
# -----------------------------------------------------------------------------
celerybeat-schedule
celerybeat.pid
*.rdb
*.aof
*.pid
mnesia/
rabbitmq/
rabbitmq-data/
activemq-data/

tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.rej
