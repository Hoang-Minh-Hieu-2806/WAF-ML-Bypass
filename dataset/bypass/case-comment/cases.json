[
  {
    "schema_version": "1.0",
    "id": "cc-001",
    "technique": "case-comment",
    "title": "Baseline search: điều kiện OR đúng với quote cân bằng",
    "target": "flask-mysql",
    "label": "malicious",
    "role": "baseline",
    "baseline_id": null,
    "control_ids": [
      "cc-002",
      "cc-003"
    ],
    "request": {
      "method": "GET",
      "path": "/search",
      "params": [
        [
          "q",
          "zz' OR '1'='1' OR username LIKE 'zz"
        ]
      ],
      "form": [],
      "headers": {},
      "raw_query": null,
      "raw_body": null
    },
    "expected_app": {
      "selected": {
        "q": "zz' OR '1'='1' OR username LIKE 'zz"
      },
      "semantic_effect": true,
      "sql_error": false,
      "http_status": 200
    },
    "note": "SQL thành LIKE '%zz' OR '1'='1' OR username LIKE 'zz%': điều kiện giữa đúng; truy vấn bind tìm chuỗi literal không khớp seed. Dự đoán source, chưa đo WAF/MySQL."
  },
  {
    "schema_version": "1.0",
    "id": "cc-002",
    "technique": "case-comment",
    "title": "Đối chứng benign: từ khóa và dấu comment trong chuỗi tìm kiếm",
    "target": "flask-mysql",
    "label": "benign",
    "role": "benign-control",
    "baseline_id": null,
    "control_ids": [],
    "request": {
      "method": "GET",
      "path": "/search",
      "params": [
        [
          "q",
          "UNION SELECT OR /* note */"
        ]
      ],
      "form": [],
      "headers": {},
      "raw_query": null,
      "raw_body": null
    },
    "expected_app": {
      "selected": {
        "q": "UNION SELECT OR /* note */"
      },
      "semantic_effect": false,
      "sql_error": false,
      "http_status": 200
    },
    "note": "Không có dấu quote để thoát chuỗi LIKE. Các từ khóa và /* note */ chỉ là nội dung literal; không được coi là SQLi chỉ vì có token đáng ngờ."
  },
  {
