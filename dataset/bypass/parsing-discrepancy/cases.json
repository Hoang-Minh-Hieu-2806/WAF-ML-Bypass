    "control_ids": [],
    "request": {
      "method": "POST",
      "path": "/login",
      "params": [],
      "form": [],
      "headers": {
        "Content-Type": "application/json"
      },
      "raw_query": null,
      "raw_body": "{\"username\":\"alice\",\"password\":\"alice123\"}"
